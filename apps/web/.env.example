# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# TCM Foundation's live GA4 property. A Measurement ID is public config -
# it is visible in the page source of every site that uses it - so the real
# value is recorded here rather than left blank. Analytics only loads after
# the visitor accepts on the consent banner; see src/components/analytics.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LGW5PJ30H3
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

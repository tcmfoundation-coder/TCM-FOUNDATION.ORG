# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# PostgreSQL (Azure Database for PostgreSQL Flexible Server in prod)
#
# Prisma's connection pool is configured through this URL, not in code — append
# `?connection_limit=N&pool_timeout=30` in production. N must be chosen from the
# actual deployment: the server tier's max_connections budget divided across
# every concurrently running app instance (leaving headroom for migrations and
# admin tooling). It is deliberately left unset here because guessing it is
# worse than leaving Prisma's default: too high exhausts the server's
# connection budget, too low serialises requests under load.
DATABASE_URL=postgresql://user:password@localhost:5432/tcm_foundation

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SESSION_COOKIE_SECRET=
MFA_ENCRYPTION_KEY=

# Google OAuth (app boots fine without these — Google sign-in just returns
# 503 "not configured" until both are set)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Bootstrap Super Administrator — only used once, by `prisma db seed`, to
# create the very first privileged account (skipped entirely if unset, or
# if a Super Administrator already exists). Real credentials, not a
# placeholder — never invent these.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Cloudinary (required before Phase 2 media work lands)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Number of reverse proxies in front of this app (managed hosts normally = 1).
# Leave unset for local development. If unset in production behind a proxy,
# every client resolves to the proxy's IP — collapsing per-IP rate limiting
# into one shared bucket and recording the proxy in every audit-log entry.
# Setting it when there is NO proxy is worse: clients can then spoof their own
# IP via X-Forwarded-For and bypass rate limiting entirely.
TRUST_PROXY_HOPS=

# Transactional email (Resend).
#
#   EMAIL_PROVIDER=console  -> print emails to the API console (dev/test only;
#                              rejected at boot in production)
#   EMAIL_PROVIDER=resend   -> deliver via Resend; requires the two below
#   unset                   -> console in dev/test; in production email is
#                              DISABLED and every send fails loudly rather
#                              than being silently discarded
#
# EMAIL_FROM must be an address on a domain you have verified in Resend, e.g.
# "TCM Foundation <noreply@your-verified-domain>". The domain is not decided
# here — see the production setup checklist in the Resend implementation
# notes. Never commit a real RESEND_API_KEY; store it in the deployment's
# secret store.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Analytics / spam protection — see plan Open Questions #7.
# Turnstile is enforced on the public write endpoints (contact, newsletter,
# Support Lab, application submissions) only once TURNSTILE_SECRET_KEY is set;
# until then verification is skipped so local development keeps working. Set
# the API secret here and NEXT_PUBLIC_TURNSTILE_SITE_KEY in the web app
# together — one without the other either blocks every submission or protects
# nothing.
GA_MEASUREMENT_ID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
